---
const gmt8Time = new Date().toLocaleString('en-US', {
  timeZone: 'Asia/Singapore',
});

const currentYear = new Date(gmt8Time).getFullYear();

const links = [
  {
    href: 'https://astro.build/',
    label: 'Astro',
    type: 'text',
  },
  {
    href: 'https://github.com/ismi-abbas/portfolio_v3',
    label: 'Github Repository',
    type: 'image',
    src: '/github-mark-white.svg',
  },
];
---

<footer class='mt-24 w-full border-t border-line'>
  <div
    class='mx-auto flex max-w-[82rem] flex-col items-start justify-between gap-4 px-5 py-8 text-xs text-ink-faint sm:flex-row sm:items-center md:px-8'>
    <span class='font-mono uppercase tracking-[0.14em]'>&copy; {currentYear} Abbas Puzi / Selangor, MY</span>
    <div class='flex items-center gap-3'>
      <span>
        Built with <a
          href={links[0].href}
          target='_blank'
          rel='noopener noreferrer'
          class='font-medium text-ink-muted transition-colors duration-200 hover:text-accent'>
          {links[0].label}
        </a>
      </span>
      <span class='h-3 w-px bg-line'></span>
      <a
        href={links[1].href}
        target='_blank'
        rel='noopener noreferrer'
        class='opacity-60 transition-opacity duration-200 hover:opacity-100'
        aria-label={links[1].label}>
        <img src='/github-mark.svg' alt={links[1].label} class='h-4 w-4' />
      </a>
    </div>
  </div>
</footer>
