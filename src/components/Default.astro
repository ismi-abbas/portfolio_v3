---
import BaseHead from './BaseHead.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { VisualEditing } from '@sanity/astro/visual-editing';

const { title, description, image, layout = 'default' } = Astro.props;

const visualEditingEnabled = import.meta.env.PUBLIC_SANITY_VISUAL_EDITING_ENABLED === 'true';
---

<html lang='en'>
  <head>
    <BaseHead title={title} description={description} image={image} />
  </head>
  <body class='flex w-full flex-col items-center bg-background text-ink'>
    <Header />
    <main
      class:list={[
        'flex min-h-dvh w-full flex-col px-5 md:px-8',
        layout === 'wide' ? 'max-w-[82rem]' : 'mt-6 max-w-2xl md:px-6',
      ]}>
      <slot />
      <VisualEditing enabled={visualEditingEnabled} />
    </main>
    <Footer />
  </body>
</html>
