---
import BaseHead from './BaseHead.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { VisualEditing } from '@sanity/astro/visual-editing';

const { title, description, image } = Astro.props;

const visualEditingEnabled = import.meta.env.PUBLIC_SANITY_VISUAL_EDITING_ENABLED === 'true';
---

<html lang='en'>
  <head>
    <BaseHead title={title} description={description} image={image} />
  </head>
  <body class='bg-slate-800 w-full flex flex-col items-center justify-center'>
    <Header />
    <main class='w-full flex flex-col items-center min-h-dvh mt-4 max-w-screen-sm px-5 md:px-0'>
      <slot />
      <VisualEditing enabled={visualEditingEnabled} />
    </main>
    <Footer />
  </body>
</html>
