---
import HeaderLink from './HeaderLink.astro';
import ThemeIcon from './ThemeIcon.astro';
---

<header class='sticky top-0 z-20 w-full border-b border-line bg-background'>
  <div
    class='mx-auto grid max-w-[82rem] grid-cols-[1fr_auto] items-center gap-x-4 gap-y-2 px-5 py-3 sm:flex sm:justify-between sm:py-4 md:px-8'>
    <a
      href='/'
      class='flex items-center gap-2 font-mono text-xs font-semibold uppercase tracking-[0.14em] text-ink transition-colors hover:text-accent'>
      <span class='grid size-7 place-items-center bg-ink text-[0.65rem] text-background'>AP</span>
      <span class='hidden sm:inline'>Abbas Puzi</span>
    </a>
    <nav aria-label='Primary navigation' class='col-span-2 row-start-2 sm:col-auto sm:row-auto'>
      <ul
        class='flex items-center justify-between font-mono text-[0.68rem] font-medium uppercase tracking-[0.1em] sm:justify-start sm:gap-2'>
        <HeaderLink href='/' class='hidden sm:block'>Home</HeaderLink>
        <HeaderLink href='/projects'>Work</HeaderLink>
        <HeaderLink href='/blog'>Blog</HeaderLink>
        <HeaderLink href='/talks'>Talks</HeaderLink>
        <HeaderLink href='/contact'>Contact</HeaderLink>
        <HeaderLink href='/code-stats'>Stats</HeaderLink>
      </ul>
    </nav>
    <div class='col-start-2 row-start-1 sm:order-3 sm:col-auto sm:row-auto'>
      <ThemeIcon />
    </div>
  </div>
</header>
