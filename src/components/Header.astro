---
import HeaderLink from './HeaderLink.astro';
import ThemeIcon from './ThemeIcon.astro';
---

<header class='sticky top-0 z-20 w-full border-b border-line bg-background'>
  <div class='mx-auto flex max-w-[82rem] items-center justify-between gap-4 px-5 py-4 md:px-8'>
    <a
      href='/'
      class='flex items-center gap-2 font-mono text-xs font-semibold uppercase tracking-[0.14em] text-ink transition-colors hover:text-accent'>
      <span class='grid size-7 place-items-center bg-ink text-[0.65rem] text-background'>AP</span>
      <span class='hidden sm:inline'>Abbas Puzi</span>
    </a>
    <div class='flex items-center gap-2 sm:gap-4'>
      <nav aria-label='Primary navigation'>
        <ul class='flex items-center gap-0.5 font-mono text-[0.68rem] font-medium uppercase tracking-[0.1em] sm:gap-2'>
        <HeaderLink href='/'>Index</HeaderLink>
        <HeaderLink href='/projects'>Work</HeaderLink>
        <HeaderLink href='/blog'>Blog</HeaderLink>
        <HeaderLink href='/contact'>Contact</HeaderLink>
        </ul>
      </nav>
      <ThemeIcon />
    </div>
  </div>
</header>
