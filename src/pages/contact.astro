---
import Default from '../components/Default.astro';
import PageHeader from '../components/PageHeader.astro';

const channels = [
  { label: 'Email', value: 'abbaspuzi.dev@gmail.com', href: 'mailto:abbaspuzi.dev@gmail.com' },
  { label: 'GitHub', value: 'github.com/ismi-abbas', href: 'https://github.com/ismi-abbas' },
  { label: 'Project brief', value: 'Start an inquiry', href: '#project-inquiry' },
];

const services = [
  ['01', 'Product websites', 'Focused public experiences that communicate clearly and load quickly.'],
  ['02', 'Web applications', 'Purpose-built interfaces and systems for real workflows.'],
  ['03', 'Internal tools', 'Operational software that removes repetitive work and fragile handoffs.'],
  ['04', 'Debugging and review', 'A practical second set of eyes on performance, architecture, and delivery problems.'],
];
---

<Default title='Contact — Abbas Puzi' description='Contact Abbas Puzi about product engineering and software projects.' layout='wide'>
  <PageHeader index='06' label='Contact' title="Let's talk." description='For project work, technical collaborations, or a thoughtful conversation about software. Choose the channel that fits.' />

  <section class='grid border-x border-line lg:grid-cols-12'>
    <div class='border-b border-line px-5 py-16 sm:px-8 lg:col-span-4 lg:border-b-0 lg:border-r lg:px-12 lg:py-24 xl:px-16'>
      <p class='font-mono text-xs uppercase tracking-[0.14em] text-accent'>Based in</p>
      <h2 class='mt-3 text-3xl font-semibold tracking-tight'>Selangor,<br />Malaysia</h2>
      <p class='mt-6 max-w-xs leading-relaxed text-ink-muted'>Working across web products, operational systems, and service integrations.</p>
    </div>
    <div class='px-5 py-8 sm:px-8 lg:col-span-8 lg:px-12 lg:py-16 xl:px-16'>
      <ol class='border-t border-line'>
        {channels.map((channel, index) => (
          <li class='border-b border-line'>
            <a href={channel.href} target={channel.href.startsWith('http') ? '_blank' : undefined} rel={channel.href.startsWith('http') ? 'noopener noreferrer' : undefined} class='group grid gap-2 py-6 sm:grid-cols-[3rem_8rem_1fr_auto] sm:items-center sm:gap-5'>
              <span class='font-mono text-xs text-ink-faint'>{String(index + 1).padStart(2, '0')}</span>
              <span class='font-mono text-[0.68rem] uppercase tracking-[0.12em] text-ink-faint'>{channel.label}</span>
              <strong class='font-medium text-ink transition-colors group-hover:text-accent'>{channel.value}</strong>
              <span class='hidden text-xl text-ink-faint transition-transform group-hover:translate-x-1 sm:block'>→</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id='project-inquiry' class='grid scroll-mt-20 border-x border-t border-line lg:grid-cols-12'>
    <div class='border-b border-line px-5 py-16 sm:px-8 lg:col-span-5 lg:border-b-0 lg:border-r lg:px-12 lg:py-20 xl:px-16'>
      <p class='font-mono text-xs uppercase tracking-[0.14em] text-accent'>Project inquiry</p>
      <h2 class='mt-3 text-3xl font-semibold tracking-[-0.035em] text-ink'>Tell me what needs to work.</h2>
      <p class='mt-4 max-w-md leading-relaxed text-ink-muted'>Share the problem, who it affects, and what a good outcome looks like.</p>
      <ol class='mt-8 border-t border-line'>
        {services.map(([number, title, description]) => (
          <li class='grid grid-cols-[2rem_1fr] gap-4 border-b border-line py-5'>
            <span class='font-mono text-xs text-ink-faint'>{number}</span>
            <div>
              <h3 class='font-semibold text-ink'>{title}</h3>
              <p class='mt-2 text-sm leading-relaxed text-ink-muted'>{description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <div class='px-5 py-16 sm:px-8 lg:col-span-7 lg:px-12 lg:py-20 xl:px-16'>
      <form class='relative space-y-8' novalidate>
        <label class='absolute -left-[9999px] top-auto size-px overflow-hidden' aria-hidden='true'>
          Website
          <input type='text' name='website' tabindex='-1' autocomplete='off' />
        </label>
        <div class='grid gap-8 sm:grid-cols-2'>
          <label class='block'>
            <span class='font-mono text-[0.68rem] uppercase tracking-[0.12em] text-ink-faint'>Your name</span>
            <input type='text' name='name' required autocomplete='name' class='mt-3 w-full border-0 border-b border-line bg-transparent px-0 py-3 text-ink outline-none transition-colors placeholder:text-ink-faint focus:border-accent focus:ring-0' placeholder='Name or team' />
          </label>
          <label class='block'>
            <span class='font-mono text-[0.68rem] uppercase tracking-[0.12em] text-ink-faint'>Email address</span>
            <input type='email' name='email' required autocomplete='email' class='mt-3 w-full border-0 border-b border-line bg-transparent px-0 py-3 text-ink outline-none transition-colors placeholder:text-ink-faint focus:border-accent focus:ring-0' placeholder='you@company.com' />
          </label>
        </div>
        <label class='block'>
          <span class='font-mono text-[0.68rem] uppercase tracking-[0.12em] text-ink-faint'>The brief</span>
          <textarea name='projectDetails' rows='7' required class='mt-3 w-full resize-y border border-line bg-surface p-4 leading-relaxed text-ink outline-none transition-colors placeholder:text-ink-faint focus:border-accent focus:ring-0' placeholder='What are you building, fixing, or trying to understand?'></textarea>
        </label>
        <div class='flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between'>
          <button type='submit' class='group inline-flex items-center justify-between gap-10 bg-ink px-5 py-3 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-background transition-colors hover:bg-accent disabled:cursor-wait disabled:opacity-60'>
            <span>Send project brief</span><span class='transition-transform group-hover:translate-x-1'>→</span>
          </button>
          <p id='form-status' class='min-h-5 text-sm text-ink-muted' aria-live='polite'></p>
        </div>
      </form>
    </div>
  </section>

  <script>
    const form = document.querySelector('form');
    const status = document.querySelector('#form-status');
    const button = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity() || !status || !button) return;

      const formData = new FormData(form);
      button.disabled = true;
      status.textContent = 'Sending your brief…';

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: formData.get('name'),
            email: formData.get('email'),
            projectDetails: formData.get('projectDetails'),
            website: formData.get('website'),
          }),
        });

        if (!response.ok) throw new Error(`Request failed with status ${response.status}`);
        form.reset();
        status.textContent = 'Brief sent. Thank you.';
      } catch (error) {
        console.error('Error sending project brief:', error);
        status.textContent = 'Could not send. Please email abbaspuzi.dev@gmail.com instead.';
      } finally {
        button.disabled = false;
      }
    });
  </script>
</Default>
