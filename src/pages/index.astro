---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Default from '../components/Default.astro';
import { SITE_DESCRIPTION } from '../consts';

const biography = [
  {
    date: '2025 - Present',
    role: 'Senior Software Engineer',
    company: 'Bloomthis Flora 💐',
    description:
      'Building and maintaining internal ERP system(OMNI) for Bloomthis Flora. Shaping the engineering culture.',
  },
  {
    date: '2024',
    role: 'Web Developer',
    company: 'CTOS Credit System 🏦',
    description:
      'Maintaining BAU web applications for credit reporting systems(B2B) and customer facing report purchase portal(B2C).',
  },
  {
    date: '2023',
    role: 'Software Engineer',
    company: 'Petronas Digital (FPT Software) ⛽',
    description: 'Basically a vendor for Petronas. Deploy to work in Pipeline Management System. The gas pipeline one.',
  },
  {
    date: '2022',
    role: 'Software Developer',
    company: 'Maybank 🏦',
    description: 'Landed a job in Graduate Programme, NEXT',
  },
];
---

<html lang='en'>
  <head>
    <BaseHead title='Abbas Puzi' description={SITE_DESCRIPTION} />
  </head>
  <Default>
    <div class='flex justify-between w-full items-end'>
      <div class='w-full flex gap-2 hover:scale-105 transition-transform duration-300 justify-center'>
        <Image
          src='/landing-page.webp'
          alt='jom_launch'
          width={200}
          height={200}
          class='object-cover object-left-top rounded-lg'
        />
      </div>

      <div class='w-full text-white'>
        <h1 class='text-4xl font-semibold'>Abbas Puzi</h1>
        <h3 class='text-lg'>Digital <span class='bg-sky-800 px-1'>Craftsman</span></h3>
      </div>

      <!-- <div
      class='max-w-lg bg-slate-700 mt-4 text-center p-2 w-full rounded-md text-lg font-medium backdrop-blur-lg backdrop-filter text-slate-200'>
      <h3>Hello, I'm a Fullstack Developer based in Malaysia!</h3>
    </div> -->
    </div>

    <section class='w-full text-white mt-4'>
      <!-- <h1 class='underline underline-offset-4 decoration-2 decoration-slate-600 font-medium text-lg'>Bio</h1> -->
      <div class='leading-relaxed tracking-wide mt-4 space-y-3 font-thin text-pretty'>
        <p>
          "Hey there! 👋 I’m Abbas, a software dev based here in Selangor, Malaysia. I love building cool web apps and
          making the internet look good.
        </p>
        <p>
          💻 Here is what I usually work with:
          <ul class='list-disc list-inside ml-4 mt-2 space-y-1'>
            <li><strong>Node.js</strong> - Can&apos;t stay away from JS</li>
            <li><strong>TypeScript</strong> - Can&apos;t live without the types</li>
            <li><strong>React & Next.js</strong> - Most comfortable with these</li>
            <li><strong>Tailwind CSS</strong> - Do people still wring plain CSS?</li>
          </ul>
        </p>
        <p>
          🚀 I’m all about turning fun ideas into real, working products without the headache. I love a good challenge
          and solving creative problems.
        </p>
        <p>Got a vision you want to bring to life? Let’s team up and build something awesome together!</p>
      </div>

      <section class='w-full text-white mt-4'>
        <div class='flex items-center justify-between'>
          <h1 class='underline underline-offset-4 decoration-2 decoration-slate-600 font-medium text-lg'>Career</h1>
          <a
            href='/resume.pdf'
            target='_blank'
            class='inline-flex items-center gap-1 text-sm text-neutral-400 hover:text-sky-500 transition-colors'>
            <span>View Resume</span>
            <svg xmlns='http://www.w3.org/2000/svg' class='size-4' viewBox='0 0 24 24'>
              <path
                fill='currentColor'
                d='M13 19h-2v-8.25L8.75 13l-1.5-1.5L12 6.75l4.75 4.75l-1.5 1.5L13 10.75zm7 3H4v-9h2v7h12v-7h2z'></path>
            </svg>
          </a>
        </div>
        <div class='flex flex-col font-light mt-4 space-y-4'>
          {
            biography.map(({ date, role, company, description }) => (
              <div class='flex flex-col space-y-1'>
                <div class='flex items-center gap-2'>
                  <span class='text-neutral-400 text-sm'>{date}</span>
                  <span class='h-[1px] w-4 bg-neutral-700' />
                  <span class='text-sky-500 font-medium'>{role}</span>
                </div>
                <div class='flex flex-col pl-6'>
                  <span class='text-neutral-300'>{company}</span>
                  <p class='text-sm text-neutral-400'>{description}</p>
                </div>
              </div>
            ))
          }
        </div>
      </section>
    </section>
  </Default>
</html>
