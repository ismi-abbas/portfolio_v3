---
import BaseHead from '../components/BaseHead.astro';
import Default from '../components/Default.astro';

const projects = [
  {
    index: '01',
    title: 'Walimah.co',
    type: 'Product engineering',
    description: 'A digital wedding invitation platform with custom themes and real-time guest management.',
    stack: ['Next.js', 'Postgres', 'Vercel'],
    href: 'https://walimah.co/',
  },
  {
    index: '02',
    title: 'Karbon Kore Store',
    type: 'Headless commerce',
    description: 'A focused storefront pairing Shopify commerce infrastructure with a custom product experience.',
    stack: ['Next.js', 'Shopify', 'Tailwind'],
    href: 'https://store.karbonko.re/',
  },
  {
    index: '03',
    title: 'WTF Tech',
    type: 'Community platform',
    description: 'An event and registration experience built for Karbon Kore’s creative technology community.',
    stack: ['Next.js', 'Vercel', 'Open source'],
    href: 'https://tech.karbon.wtf/',
  },
];

const capabilities = [
  {
    number: 'A',
    title: 'Product engineering',
    description: 'From an ambiguous brief to a maintainable product people can use, test, and grow.',
  },
  {
    number: 'B',
    title: 'Internal systems',
    description: 'Operational software that replaces fragile processes with clear, reliable workflows.',
  },
  {
    number: 'C',
    title: 'Platform integrations',
    description: 'APIs and service connections designed around real business constraints, not demos.',
  },
];

const experience = [
  ['2025—Now', 'Senior Software Engineer', 'BloomThis Flora'],
  ['2024', 'Web Developer', 'CTOS Credit Systems'],
  ['2023', 'Software Engineer', 'Petronas Digital / FPT'],
  ['2022', 'Software Developer', 'Maybank'],
];
---

<html lang='en'>
  <head>
    <BaseHead
      title='Abbas Puzi — Software Engineer'
      description='Product engineering, internal systems, and integrations built by Abbas Puzi in Selangor, Malaysia.'
    />
  </head>
  <Default layout='wide'>
    <div class='portfolio-grid pointer-events-none absolute inset-x-0 top-[4.25rem] -z-10 h-[46rem]' aria-hidden='true'></div>

    <section class='grid min-h-[calc(100svh-4.25rem)] grid-cols-1 border-x border-line lg:grid-cols-12'>
      <div class='flex flex-col justify-between border-b border-line p-5 sm:p-8 lg:col-span-8 lg:border-b-0 lg:border-r lg:p-12 xl:p-16'>
        <div data-reveal class='flex flex-wrap items-center justify-between gap-3 font-mono text-[0.68rem] uppercase tracking-[0.14em] text-ink-faint'>
          <span>Independent product engineering</span>
          <span class='flex items-center gap-2 text-ink-muted'><span class='size-1.5 rounded-full bg-accent'></span> Products / systems / integrations</span>
        </div>

        <div class='py-20 sm:py-24 lg:py-16'>
          <p data-reveal style='--reveal-delay: 80ms' class='mb-5 font-mono text-xs uppercase tracking-[0.16em] text-accent'>
            Abbas Puzi / Software engineer
          </p>
          <h1 data-reveal style='--reveal-delay: 120ms' class='max-w-[12ch] font-display text-[clamp(3.5rem,9vw,8.75rem)] font-semibold leading-[0.82] tracking-[-0.065em] text-ink'>
            I build web products and internal systems.
          </h1>
          <p data-reveal style='--reveal-delay: 180ms' class='mt-8 max-w-xl text-lg leading-relaxed text-ink-muted sm:text-xl'>
            I help teams turn unclear requirements into dependable software, from customer-facing products to service integrations.
          </p>
        </div>

        <div data-reveal style='--reveal-delay: 240ms' class='flex flex-col gap-6 border-t border-line pt-6 sm:flex-row sm:items-end sm:justify-between'>
          <div class='flex flex-wrap gap-3'>
            <a href='/contact' class='group inline-flex items-center gap-5 bg-ink px-5 py-3 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-background transition-colors hover:bg-accent'>
              Start a conversation <span class='transition-transform group-hover:translate-x-1'>→</span>
            </a>
            <a href='#work' class='inline-flex items-center border border-line px-5 py-3 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-ink transition-colors hover:border-ink hover:bg-surface'>
              See selected work
            </a>
          </div>
          <span class='font-mono text-[0.68rem] uppercase leading-relaxed tracking-[0.12em] text-ink-faint'>Selangor, Malaysia<br />03°04′N / 101°31′E</span>
        </div>
      </div>

      <aside class='relative min-h-[32rem] overflow-hidden bg-surface-2 lg:col-span-4'>
        <img src='/landing-page.webp' alt='Abbas Puzi, software engineer' width='440' height='480' class='absolute inset-0 size-full object-cover object-top grayscale transition duration-700 hover:grayscale-0' />
        <div class='absolute inset-x-0 bottom-0 flex items-end justify-between bg-gradient-to-t from-[oklch(0.12_0.01_55/0.88)] via-[oklch(0.12_0.01_55/0.32)] to-transparent p-6 pt-24 font-mono text-[0.68rem] uppercase tracking-[0.14em] text-[oklch(0.94_0.01_75)] sm:p-8'>
          <span>Portrait / 2026</span>
          <span>Engineer<br />& builder</span>
        </div>
      </aside>
    </section>

    <section id='work' class='border-x border-t border-line px-5 py-20 sm:px-8 sm:py-28 lg:px-12 xl:px-16'>
      <div class='grid gap-8 lg:grid-cols-12 lg:gap-12'>
        <div class='lg:col-span-4'>
          <p class='font-mono text-xs uppercase tracking-[0.16em] text-accent'>01 / Selected work</p>
          <h2 class='mt-4 max-w-[9ch] text-[clamp(2.5rem,5vw,4.75rem)] font-semibold leading-[0.95] tracking-[-0.045em]'>Built to leave the prototype stage.</h2>
        </div>
        <div class='lg:col-span-8'>
          <ol class='border-t border-line'>
            {projects.map((project) => (
              <li class='group border-b border-line'>
                <a href={project.href} target='_blank' rel='noopener noreferrer' class='grid gap-5 py-7 sm:grid-cols-[3rem_1fr_auto] sm:items-start sm:gap-6'>
                  <span class='font-mono text-xs text-ink-faint'>{project.index}</span>
                  <div>
                    <div class='flex flex-wrap items-baseline gap-x-3 gap-y-1'>
                      <h3 class='text-2xl font-semibold tracking-tight text-ink transition-colors group-hover:text-accent sm:text-3xl'>{project.title}</h3>
                      <span class='font-mono text-[0.68rem] uppercase tracking-[0.12em] text-ink-faint'>{project.type}</span>
                    </div>
                    <p class='mt-3 max-w-2xl leading-relaxed text-ink-muted'>{project.description}</p>
                    <ul class='mt-4 flex flex-wrap gap-x-4 gap-y-2 font-mono text-[0.68rem] uppercase tracking-[0.1em] text-ink-faint'>
                      {project.stack.map((item) => <li>{item}</li>)}
                    </ul>
                  </div>
                  <span class='hidden font-mono text-xl text-ink-faint transition-all group-hover:translate-x-1 group-hover:text-accent sm:block'>↗</span>
                </a>
              </li>
            ))}
          </ol>
          <a href='/projects' class='mt-7 inline-flex items-center gap-3 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-ink transition-colors hover:text-accent'>View the full work index <span>→</span></a>
        </div>
      </div>
    </section>

    <section class='border-x border-t border-line bg-ink px-5 py-20 text-background sm:px-8 sm:py-24 lg:px-12 xl:px-16'>
      <div class='flex flex-col justify-between gap-5 border-b border-background/20 pb-8 md:flex-row md:items-end'>
        <div>
          <p class='font-mono text-xs uppercase tracking-[0.16em] text-accent'>02 / Ways I can help</p>
          <h2 class='mt-4 text-[clamp(2.5rem,5vw,4.75rem)] font-semibold leading-none tracking-[-0.045em]'>Useful from day one.</h2>
        </div>
        <p class='max-w-md leading-relaxed text-background/70'>A practical engineering partner for new builds, difficult systems, and the unglamorous details that make products reliable.</p>
      </div>
      <ol class='grid md:grid-cols-3'>
        {capabilities.map((capability, index) => (
          <li class:list={['py-8 md:py-10', index > 0 && 'border-t border-background/20 md:border-l md:border-t-0 md:pl-8', index < 2 && 'md:pr-8']}>
            <span class='font-mono text-xs text-accent'>{capability.number}</span>
            <h3 class='mt-12 text-2xl font-semibold tracking-tight'>{capability.title}</h3>
            <p class='mt-3 max-w-sm leading-relaxed text-background/65'>{capability.description}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class='grid border-x border-t border-line lg:grid-cols-12'>
      <div class='border-b border-line px-5 py-16 sm:px-8 lg:col-span-4 lg:border-b-0 lg:border-r lg:px-12 lg:py-24 xl:px-16'>
        <p class='font-mono text-xs uppercase tracking-[0.16em] text-accent'>03 / Experience</p>
        <h2 class='mt-4 text-4xl font-semibold leading-tight tracking-[-0.04em] sm:text-5xl'>Four industries.<br />One throughline.</h2>
        <p class='mt-6 max-w-sm leading-relaxed text-ink-muted'>Shipping business-critical software across commerce, credit, energy, and banking.</p>
      </div>
      <div class='px-5 py-8 sm:px-8 lg:col-span-8 lg:px-12 lg:py-16 xl:px-16'>
        <ol class='border-t border-line'>
          {experience.map(([date, role, company]) => (
            <li class='grid gap-2 border-b border-line py-5 sm:grid-cols-[7rem_1fr_auto] sm:items-baseline sm:gap-6'>
              <span class='font-mono text-xs text-ink-faint'>{date}</span>
              <strong class='font-medium text-ink'>{role}</strong>
              <span class='text-sm text-ink-muted sm:text-right'>{company}</span>
            </li>
          ))}
        </ol>
        <a href='/resume.pdf' target='_blank' class='mt-7 inline-flex items-center gap-3 font-mono text-xs font-semibold uppercase tracking-[0.12em] text-ink transition-colors hover:text-accent'>Open full résumé <span>↗</span></a>
      </div>
    </section>

    <section class='relative overflow-hidden border-x border-t border-line px-5 py-24 sm:px-8 sm:py-32 lg:px-12 xl:px-16'>
      <span class='pointer-events-none absolute -right-4 -top-14 font-mono text-[12rem] font-bold leading-none text-surface-2 sm:text-[18rem]' aria-hidden='true'>*</span>
      <div class='relative max-w-4xl'>
        <p class='font-mono text-xs uppercase tracking-[0.16em] text-accent'>Have a useful problem?</p>
        <h2 class='mt-5 text-[clamp(3rem,7vw,7rem)] font-semibold leading-[0.9] tracking-[-0.055em]'>Let’s make it work.</h2>
        <a href='/contact' class='group mt-10 inline-flex items-center gap-8 border-b border-ink pb-2 text-lg font-semibold transition-colors hover:border-accent hover:text-accent'>Tell me what you’re building <span class='transition-transform group-hover:translate-x-1'>→</span></a>
      </div>
    </section>
  </Default>
</html>
