---
import { Image } from 'astro:assets';
import Default from '../../components/Default.astro';
import PageHeader from '../../components/PageHeader.astro';
import { urlFor } from '../../sanity/lib/urlFor';
import { getPosts } from '../../sanity/utils';

const posts = (await getPosts()).sort((a, b) => {
  const dateA = new Date(a.publishedAt ?? a._createdAt).getTime();
  const dateB = new Date(b.publishedAt ?? b._createdAt).getTime();
  return dateB - dateA;
});
---

<Default title='Field Notes — Abbas Puzi' description='Notes from Abbas Puzi about software engineering, systems, and building for the web.' layout='wide'>
  <PageHeader index='02' label='Field notes' title='Writing from the workbench.' description='Occasional notes on software, systems, experiments, and the lessons that only appear after something ships.' />

  <section class='border-x border-line px-5 py-16 sm:px-8 sm:py-24 lg:px-12 xl:px-16'>
    <div class='mb-8 flex items-end justify-between gap-6 border-b border-line pb-5'>
      <div>
        <p class='font-mono text-xs uppercase tracking-[0.14em] text-accent'>Published archive</p>
        <h2 class='mt-2 text-2xl font-semibold tracking-tight'>{posts.length} {posts.length === 1 ? 'entry' : 'entries'}</h2>
      </div>
      <span class='hidden font-mono text-[0.68rem] uppercase tracking-[0.12em] text-ink-faint sm:block'>Newest first</span>
    </div>

    {posts.length > 0 ? (
      <ol>
        {posts.map((post, index) => {
          const publishedAt = post.publishedAt ?? post._createdAt;
          return (
            <li class='group border-b border-line first:border-t'>
              <a href={`/blog/${post.slug.current}`} class='grid gap-6 py-7 md:grid-cols-[3rem_1fr_15rem] md:items-start lg:grid-cols-[3rem_1fr_22rem] lg:gap-10'>
                <span class='font-mono text-xs text-ink-faint'>{String(index + 1).padStart(2, '0')}</span>
                <div>
                  <p class='font-mono text-[0.68rem] uppercase tracking-[0.12em] text-accent'>
                    {new Date(publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                  </p>
                  <h3 class='mt-3 max-w-[18ch] text-3xl font-semibold leading-tight tracking-[-0.035em] text-ink transition-colors group-hover:text-accent sm:text-4xl'>{post.title}</h3>
                  {post.description && <p class='mt-4 max-w-2xl leading-relaxed text-ink-muted'>{post.description}</p>}
                  {post.categories && post.categories.length > 0 && (
                    <ul class='mt-5 flex flex-wrap gap-x-4 gap-y-2 font-mono text-[0.65rem] uppercase tracking-[0.1em] text-ink-faint'>
                      {post.categories.map((category) => <li>{category.title}</li>)}
                    </ul>
                  )}
                  <span class='mt-7 inline-flex items-center gap-4 font-mono text-[0.68rem] font-semibold uppercase tracking-[0.1em]'>Read note <span class='transition-transform group-hover:translate-x-1'>→</span></span>
                </div>
                <div class='overflow-hidden border border-line bg-surface-2'>
                  {post.mainImage ? (
                    <Image src={urlFor(post.mainImage).url()} alt='' width={520} height={340} class='aspect-[13/8] size-full object-cover grayscale transition duration-700 group-hover:scale-[1.02] group-hover:grayscale-0' />
                  ) : (
                    <div class='portfolio-grid grid aspect-[13/8] place-items-center font-mono text-5xl font-bold text-line'>{String(index + 1).padStart(2, '0')}</div>
                  )}
                </div>
              </a>
            </li>
          );
        })}
      </ol>
    ) : (
      <div class='border-y border-line py-20 text-center'>
        <p class='font-mono text-xs uppercase tracking-[0.12em] text-ink-faint'>No notes published yet</p>
      </div>
    )}
  </section>
</Default>
