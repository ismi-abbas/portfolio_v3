---
import type { Image, SanityDocument } from '@sanity/types';
import Default from '../../components/Default.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import PortableText from '../../components/PortableText.astro';
import { loadQuery } from '../../sanity/lib/load-query';
import { urlFor } from '../../sanity/lib/urlFor';

interface Post extends SanityDocument {
  title: string;
  description?: string;
  mainImage?: Image;
  slug: { current: string };
  body: any;
  _updatedAt: string;
}

export const prerender = true;

export async function getStaticPaths() {
  const { data: posts } = await loadQuery<Post[]>({
    query: `*[_type == "post" && defined(slug.current)] | order(_createdAt desc)`,
  });

  return posts?.map(({ slug }) => ({ params: { slug: slug.current } }));
}

const { params } = Astro;
const { data: post } = await loadQuery<Post>({
  query: `*[_type == "post" && slug.current == $slug][0]`,
  params: { slug: params.slug },
});
---

<Default title={`${post?.title ?? 'Field Note'} — Abbas Puzi`} description={post?.description ?? 'A field note by Abbas Puzi.'} layout='wide'>
  <article class='border-x border-line'>
    <header class='grid border-b border-line lg:grid-cols-12'>
      <div class='px-5 py-16 sm:px-8 sm:py-24 lg:col-span-9 lg:border-r lg:px-12 xl:px-16'>
        <a href='/blog' class='font-mono text-xs uppercase tracking-[0.14em] text-accent transition-colors hover:text-accent-strong'>← Field notes</a>
        <h1 class='mt-6 max-w-[14ch] text-[clamp(3rem,7vw,7rem)] font-semibold leading-[0.9] tracking-[-0.055em]'>{post?.title}</h1>
        {post?.description && <p class='mt-7 max-w-2xl text-lg leading-relaxed text-ink-muted sm:text-xl'>{post.description}</p>}
      </div>
      <div class='flex flex-col justify-end gap-3 p-5 sm:p-8 lg:col-span-3'>
        <span class='font-mono text-[0.65rem] uppercase tracking-[0.12em] text-ink-faint'>Last revised</span>
        {post?._updatedAt && <FormattedDate date={new Date(post._updatedAt)} />}
      </div>
    </header>

    {post?.mainImage && (
      <div class='border-b border-line bg-surface-2 p-3 sm:p-6'>
        <img width='1400' height='760' src={urlFor(post.mainImage).width(1600).url()} alt={post.title} class='max-h-[44rem] w-full object-cover' />
      </div>
    )}

    <div class='grid lg:grid-cols-12'>
      <aside class='hidden border-r border-line px-8 py-16 lg:col-span-3 lg:block xl:px-12'>
        <div class='sticky top-28'>
          <p class='font-mono text-[0.65rem] uppercase tracking-[0.12em] text-ink-faint'>Reading note</p>
          <p class='mt-4 max-w-[22ch] text-sm leading-relaxed text-ink-muted'>Written from practice. Keep what is useful; question what is not.</p>
        </div>
      </aside>
      <div class='px-5 py-14 sm:px-8 sm:py-20 lg:col-span-9 lg:px-16 xl:px-24'>
        <div class='prose prose-lg max-w-[46rem] text-ink-muted
          prose-headings:font-semibold prose-headings:tracking-tight prose-headings:text-ink
          prose-p:leading-[1.8] prose-p:text-ink-muted
          prose-a:font-medium prose-a:text-accent prose-a:decoration-line prose-a:underline-offset-4 hover:prose-a:text-accent-strong
          prose-strong:text-ink
          prose-pre:overflow-x-auto prose-pre:border prose-pre:border-line prose-pre:bg-[oklch(0.16_0.012_58)]
          prose-code:font-mono prose-code:text-sm
          prose-ul:text-ink-muted prose-ol:text-ink-muted prose-li:marker:text-accent
          prose-blockquote:border-0 prose-blockquote:bg-surface-2 prose-blockquote:px-6 prose-blockquote:py-3 prose-blockquote:not-italic prose-blockquote:text-ink-muted
          prose-hr:border-line prose-img:border prose-img:border-line'>
          <PortableText portableText={post?.body} />
        </div>

        <div class='mt-16 border-t border-line pt-8'>
          <a href='/blog' class='group inline-flex items-center gap-4 font-mono text-xs font-semibold uppercase tracking-[0.12em] transition-colors hover:text-accent'>
            <span class='transition-transform group-hover:-translate-x-1'>←</span> Back to all notes
          </a>
        </div>
      </div>
    </div>
  </article>
</Default>
